# RELIC backup configuration.
#
# Install as /etc/relic/backup.env, owned by root and mode 0600:
#
#   install -d -m 0755 /etc/relic
#   install -m 0600 /srv/relic/backup/scripts/backup.env.example /etc/relic/backup.env
#   editor /etc/relic/backup.env
#
# The file is sourced by backup/scripts/backup-relic.sh. It must not contain private
# keys or passwords. The age recipient is a public key.

# PostgreSQL database to dump.
RELIC_DATABASE=relic

# Run PostgreSQL client commands as this operating-system user. On Debian this
# is normally "postgres"; set it to an empty string only for local testing or
# for a role that can dump the database directly.
RELIC_PG_RUNAS=postgres

# Optional PostgreSQL connection overrides. Leave empty for the normal local
# peer-authentication setup.
RELIC_PG_HOST=
RELIC_PG_PORT=
RELIC_PG_USER=

# Local staging directory. Encrypted run directories are kept here until the
# local retention window expires.
RELIC_BACKUP_STAGING=/var/backups/relic
RELIC_BACKUP_LOCAL_RETAIN_DAYS=7

# Repository checkout whose commit and migration list are recorded in every
# manifest.
RELIC_REPO_DIR=/srv/relic

# Object-store roots. FIDBF storage_path values are relative to the FIDBF root;
# provenance storage_path values are absolute under the provenance root.
RELIC_FIDBF_ROOT=/srv/relic-objects
RELIC_PROVENANCE_ROOT=/srv/relic-data

# System signing keys and passphrase files. This directory is root-only.
RELIC_KEYS_DIR=/var/lib/relic/keys

# PostgreSQL configuration directory.
RELIC_PG_CONFIG_DIR=/etc/postgresql/15/main

# One or more age recipients. Separate multiple recipients with spaces or
# commas. Only public recipients belong here; the private identity stays
# offline.
#
#   age-keygen -o relic-backup-age.key
#   age-keygen -y relic-backup-age.key
#
RELIC_BACKUP_AGE_RECIPIENTS=

# Offsite rsync destination. This is the directory to which the run files are
# uploaded. For a restricted rrsync account, use a path relative to the rrsync
# base, for example:
#
#   RELIC_BACKUP_REMOTE="relic-backup@backup-host:."
#
# For a normal SSH account, use the actual directory:
#
#   RELIC_BACKUP_REMOTE="relic-backup@backup-host:/srv/backups/relic/incoming"
#
# For local testing only, an absolute local path is accepted:
#
#   RELIC_BACKUP_REMOTE="/tmp/relic-backup-incoming"
#
RELIC_BACKUP_REMOTE=

# SSH transport settings for the backup upload. The key must be readable only
# by root. Verify the backup host fingerprint out of band before adding it to
# known_hosts.
RELIC_BACKUP_SSH_KEY=/root/.ssh/relic_backup_ed25519
RELIC_BACKUP_SSH_PORT=22
RELIC_BACKUP_KNOWN_HOSTS=/root/.ssh/known_hosts

# Testing only. Do not set this in production. When set to 1, the backup script
# permits non-root execution and expects RELIC_PG_RUNAS to be empty or usable
# by the calling user.
RELIC_BACKUP_ALLOW_NONROOT=0
