RELIC_HOST=relic.example.org
# PostgreSQL on the host, reached through its Unix socket (mounted into the
# container by docker-compose.yml); see docs/deployment.md. A TCP URL to a
# remote host must use TLS (sslmode=verify-full or require) or the API refuses it.
RELIC_DATABASE_URL=postgresql://relic_app:change-me@/relic?host=/var/run/postgresql
RELIC_JWT_SECRET=replace-with-at-least-32-random-characters
# Optional upload and download limits (docs/deployment.md has the table).
# RELIC_MAX_OBJECT_BYTES=67108864
# RELIC_MAX_STAGING_BYTES=4294967296
# RELIC_MAX_UPLOADS_PER_ANALYST=2
# RELIC_MAX_UPLOADS_TOTAL=8
# RELIC_UPLOAD_BYTES_PER_ANALYST_PER_DAY=1073741824
# RELIC_DOWNLOAD_RATE_LIMIT_PER_HOUR=120
# Caddy: how long a client may take to send a request body (docker compose).
# RELIC_READ_BODY_TIMEOUT=5m
# Host directories for docker compose (the container always sees them at
# /var/lib/relic/staging and /srv/relic-objects); see docs/deployment.md.
# RELIC_STAGING_DIR=/var/lib/relic/staging
# RELIC_FIDBF_ROOT=/srv/relic-objects
