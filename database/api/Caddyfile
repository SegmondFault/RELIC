{
	default_sni {$RELIC_HOST}
	# A client must send its headers within 10s and its whole body within
	# RELIC_READ_BODY_TIMEOUT (a 64 MB upload in 5 minutes needs ~220 KB/s),
	# so slow clients cannot hold the API's connections open.
	servers {
		timeouts {
			read_header 10s
			read_body {$RELIC_READ_BODY_TIMEOUT:5m}
		}
	}
	cert_issuer acme {$ACME_CA} {
		profile {$ACME_PROFILE}
	}
}

{$RELIC_HOST} {
	tls {
		protocols tls1.2 tls1.3
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
		-Via
	}
	# FIDBF uploads, then submissions (FIDBF manifests, BSim, provenance),
	# then everything else. The API enforces the same limits.
	@object_upload path /v1/fidbf-objects/*
	request_body @object_upload {
		max_size 64MB
	}
	@submission path /v1/fidbf /v1/bsim /v1/provenance
	request_body @submission {
		max_size 4MB
	}
	@other not path /v1/fidbf-objects/* /v1/fidbf /v1/bsim /v1/provenance
	request_body @other {
		max_size 1MB
	}
	header {
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	}
	encode zstd gzip
	reverse_proxy api:8000 {
		header_up -X-Forwarded-For
		header_up X-Forwarded-For {remote_host}
	}
}
